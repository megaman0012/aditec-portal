# Copiar a .env (chmod 600). NUNCA hacer commit de .env.

# --- MBA3 (solo red interna, SOLO LECTURA) ---
MBA3_BASE=http://192.168.1.203:8081
MBA3_CODIGO=
MBA3_PWD=
MBA3_EMPRESA=ADITE
# Pausa mínima entre peticiones (anti-veto de IP). El código impone piso de 1500.
MBA3_PAUSA_MS=1500
# Renovar el JWT a los N minutos (la sesión MBA3 dura ~10)
MBA3_RENOVAR_MIN=8
# Máximo de filas por consulta
MBA3_LIMIT=5000

# --- Portal ---
PORT=8090
# Generar con: openssl rand -hex 32
SESSION_SECRET=
SESSION_HORAS=8
# true cuando el portal esté detrás de HTTPS (cookie Secure)
COOKIE_SECURE=false

# --- Sincronizador ---
# Interruptor general (true para que el servidor sincronice con MBA3 en segundo plano)
SYNC_ACTIVO=false
# Refresco del mes en curso (minutos)
SYNC_MES_ACTUAL_MIN=30
SYNC_HISTORIA_DESDE=2025-01-01

TZ=America/Guayaquil

# --- Proxy inverso (solo cuando el portal esté detrás del proxy común) ---
# TRUST_PROXY=true
# TRUSTED_PROXY_IPS=172.18.0.0/16
